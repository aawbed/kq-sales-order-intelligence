# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real credentials.

DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Data tier (see System Architecture Diagram, Figure 3.5)
# Leave DB_ENGINE unset to fall back to local SQLite for development.
DB_ENGINE=mysql
DB_NAME=kq_sales_order_intelligence
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
