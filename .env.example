# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real credentials.

DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Data tier (see System Architecture Diagram, Figure 3.5)
# Set to 'sqlite' for zero-config file database (default), or 'mysql' for cloud MySQL.
DB_ENGINE=sqlite
DB_NAME=kq_sales_order_intelligence
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
